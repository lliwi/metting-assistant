# Copiar a .env (nunca versionar) y sustituir todos los CHANGE_ME.
# Genera los secretos con:  openssl rand -hex 32
# Usa solo caracteres hexadecimales en las contraseñas: van dentro de URLs.

ENVIRONMENT=production
LOG_LEVEL=INFO
HTTP_PORT=8080
IMAGE_TAG=dev

POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Garage exige el formato de clave: S3_ACCESS_KEY = "GK" + 24 hex; S3_SECRET_KEY = 64 hex.
#   echo "GK$(openssl rand -hex 12)"   /   openssl rand -hex 32
S3_BUCKET=recordings
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME

# URL pública (enlaces de email y retorno de OIDC). En producción, https://…
PUBLIC_APP_URL=http://localhost:8080
# Cookies solo por HTTPS. Ponlo a false únicamente en desarrollo sobre http.
COOKIE_SECURE=true

JWT_SIGNING_KEY=CHANGE_ME
APP_SECRET_KEY=CHANGE_ME
# Clave Fernet: base64 urlsafe de 32 bytes.
#   openssl rand -base64 32 | tr '+/' '-_'
DATA_ENCRYPTION_KEY=CHANGE_ME

# SMTP para emails de verificación, recuperación e invitaciones.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=Metting Agent <no-reply@example.com>

# Login con Google / Microsoft (opcional). URI de retorno a registrar en el proveedor:
#   ${PUBLIC_APP_URL}/api/v1/auth/oidc/google/callback
#   ${PUBLIC_APP_URL}/api/v1/auth/oidc/microsoft/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Antivirus de importaciones (ClamAV). Obligatorio en producción: activa el perfil.
COMPOSE_PROFILES=antivirus
ANTIVIRUS_MODE=clamd

# --- Transcripción -------------------------------------------------------------------------
# faster_whisper: local en worker-asr (el audio no sale de la infraestructura).
# openai: API de OpenAI o un servidor compatible (OPENAI_BASE_URL).
ASR_PROVIDER=faster_whisper
# tiny | base | small | medium | large-v3 | turbo  (más grande = más preciso y más lento)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Modelos de lenguaje (resúmenes, actas, tareas) ----------------------------------------
# ollama | openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://192.168.0.160:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=16384
# 0 = Ollama libera la memoria al responder. Recomendado si Ollama y worker-asr comparten GPU.
OLLAMA_KEEP_ALIVE=5m

# --- OpenAI (opcional) ---------------------------------------------------------------------
# Necesaria si ASR_PROVIDER=openai o LLM_PROVIDER=openai. El audio o el texto se envían a OpenAI:
# revisa el DPA y la residencia de datos antes de activarlo.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Modelo de chat con salida estructurada (json_schema), p. ej. el que tengáis contratado.
OPENAI_LLM_MODEL=
